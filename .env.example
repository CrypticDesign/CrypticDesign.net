# Enables local membership fixtures and internal sandbox APIs. Never enables live billing.
MEMBERSHIP_SANDBOX_ENABLED=false
# Local-only signing key for preview sessions. Use a unique value in .env.local.
MEMBERSHIP_SANDBOX_SECRET=

# Production selection: Supabase. Populate only after an approved project is provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase key. Never expose this through a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=
# Public production origin used in password-recovery email redirects.
NEXT_PUBLIC_SITE_URL=https://crypticdesign.net

# Operational account-admission state. Neither value enables browser signup.
# Future invitation admission must create Auth users through a verified,
# server-only admin path after the payment and invitation gates pass.
ACCOUNT_ADMISSION_MODE=closed

# Server-only admission outbox worker. Keep ACCOUNT_ADMISSION_MODE=closed until
# a launch wave, payment authority, scheduler, and production runbook are approved.
ADMISSION_WORKER_SECRET=
# Supabase's invite email template must send TokenHash + type=invite here;
# confirmation then redirects the verified session to /account/accept-invitation.
ADMISSION_INVITE_REDIRECT_URL=https://crypticdesign.net/auth/confirm

# Public Cloudflare Turnstile site key. Keep the corresponding secret only in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only admission secrets; generate independent values of at least 32 random characters.
ADMISSION_TOKEN_HMAC_SECRET=
ADMISSION_SESSION_SECRET=
